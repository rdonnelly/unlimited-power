{
  "name": "unlimited-power",
  "version": "1.10.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "npx expo start --dev-client",
    "dev": "npx expo start --dev-client",
    "check:deps": "npx expo install --check",
    "check:doctor": "npx expo-doctor@latest",
    "check:lint": "oxlint",
    "check:format": "oxfmt --check",
    "check:ts": "tsc",
    "format": "oxfmt",
    "build:android:dev": "npx eas-cli@latest build --platform android --profile development",
    "build:android:dev:local": "npx eas-cli@latest build --platform android --profile development --local",
    "build:ios:dev": "npx eas-cli@latest build --platform ios --profile development",
    "build:ios:simulator": "npx eas-cli@latest build --platform ios --profile development-simulator",
    "build:ios:simulator:local": "npx eas-cli@latest build --platform ios --profile development-simulator --local",
    "push:android": "npx eas-cli@latest build --platform android --auto-submit",
    "push:ios": "npx eas-cli@latest build --platform ios --auto-submit",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@bugsnag/expo": "^57.0.0",
    "@expo/html-elements": "^57.0.0",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@lodev09/react-native-true-sheet": "^3.11.18",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.1",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/query-async-storage-persister": "^5.103.1",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-query-persist-client": "^5.103.1",
    "babel-plugin-module-resolver": "^5.0.0",
    "expo": "~58.0.12",
    "expo-app-intents": "~0.5.8",
    "expo-application": "~58.1.1",
    "expo-asset": "~58.0.16",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.6",
    "expo-dev-client": "~58.0.13",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.6",
    "expo-image": "~58.0.15",
    "expo-linking": "~58.0.13",
    "expo-sharing": "~58.0.18",
    "expo-splash-screen": "~58.0.9",
    "expo-status-bar": "~58.0.3",
    "expo-web-browser": "~58.0.6",
    "lodash": "^4.17.23",
    "qs": "^6.16.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "~4.7.1",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "~0.13.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/lodash": "^4.17.25",
    "@types/qs": "^6.15.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@shopify/flash-list",
        "react-native-gesture-handler",
        "react-native-reanimated",
        "react-native-screens",
        "react-native-worklets"
      ]
    }
  },
  "private": true,
  "overrides": {
    "expo-application": "~58.1.1",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.6",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.9",
    "@bugsnag/expo": {
      "expo": "^58.0.0"
    }
  }
}
