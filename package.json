{
  "name": "unlimited-power",
  "version": "1.8.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "npx expo start --dev-client",
    "dev": "npx expo start --dev-client",
    "check:deps": "npx expo install --check",
    "check:doctor": "npx expo-doctor@latest",
    "check:lint": "eslint .",
    "check:ts": "tsc",
    "build:android:dev": "npx eas-cli@latest build --platform android --profile development",
    "build:android:dev:local": "npx eas-cli@latest build --platform android --profile development --local",
    "build:ios:dev": "npx eas-cli@latest build --platform ios --profile development",
    "build:ios:simulator": "npx eas-cli@latest build --platform ios --profile development-simulator",
    "build:ios:simulator:local": "npx eas-cli@latest build --platform ios --profile development-simulator --local",
    "push:android": "npx eas-cli@latest build --platform android --auto-submit",
    "push:ios": "npx eas-cli@latest build --platform ios --auto-submit",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@bugsnag/expo": "^55.0.0",
    "@expo/html-elements": "^55.0.3",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@lodev09/react-native-true-sheet": "^3.9.9",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/native": "^7.2.1",
    "@react-navigation/native-stack": "^7.14.9",
    "@shopify/flash-list": "^2.3.1",
    "@tanstack/query-async-storage-persister": "^5.95.2",
    "@tanstack/react-query": "^5.95.2",
    "@tanstack/react-query-persist-client": "^5.95.2",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "expo": "^56.0.0",
    "expo-application": "~56.0.3",
    "expo-asset": "~56.0.18",
    "expo-constants": "~56.0.20",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.22",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.11",
    "expo-linking": "~56.0.15",
    "expo-sharing": "~56.0.20",
    "expo-splash-screen": "~56.0.12",
    "expo-status-bar": "~56.0.4",
    "expo-web-browser": "~56.0.5",
    "lodash": "^4.17.23",
    "qs": "^6.15.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "~4.3.1",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.25.2",
    "react-native-worklets": "~0.8.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@tanstack/eslint-plugin-query": "^5.101.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/lodash": "^4.17.24",
    "@types/qs": "^6.15.0",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~56.0.0",
    "eslint": "^8.56.0",
    "eslint-config-universe": "^12.0.0",
    "eslint-plugin-react-native": "^5.0.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@shopify/flash-list",
        "react-native-gesture-handler",
        "react-native-reanimated",
        "react-native-screens",
        "react-native-worklets"
      ]
    }
  },
  "comments": {
    "overrides": "@bugsnag/expo tracks the Expo SDK major and has no SDK 56+ release; these relax its (and its plugins') expo-* / netinfo peer pins to the app's own versions. Bump these to match dependencies on each SDK upgrade."
  },
  "overrides": {
    "@bugsnag/expo": {
      "expo": "^56.0.0",
      "expo-constants": "~56.0.20"
    },
    "@bugsnag/plugin-expo-app": {
      "expo-constants": "~56.0.20",
      "expo-application": "~56.0.3"
    },
    "@bugsnag/plugin-expo-device": {
      "expo-constants": "~56.0.20",
      "expo-device": "~56.0.4"
    },
    "@bugsnag/delivery-expo": {
      "expo-crypto": "~56.0.4",
      "expo-file-system": "~56.0.8",
      "@react-native-community/netinfo": "12.0.1"
    },
    "@bugsnag/plugin-expo-connectivity-breadcrumbs": {
      "@react-native-community/netinfo": "12.0.1"
    }
  },
  "private": true
}
